# ls
alias ls='ls --color=auto'
alias ll='ls -Al'

# clear
alias cls='clear'

# cd
alias ..='cd ..'

# mkdir
function mkdircd() {
    mkdir -p "$1" && cd "$1"
}

# I mean... this could be done with `mktemp -d` and templates, but what the hell.
function mkdirtemp() {
    dir_name=$(uuidgen | awk '{split($0,arr,"-"); print arr[1] arr[5]}')
    mkdircd /tmp/$dir_name
}

# Colored and line number grep
alias grep='grep -n --color=auto'

# tmux with config file specified
alias tmux='tmux -f $HOME/.config/Scripts/tmux.conf'

# Use nvim instead of vim
alias vim='nvim'

# Colored IP
alias ip='ip --color=auto'

# Colored diff
alias diff='diff --color=auto'

# batcat
alias cat='bat -pp'

# rg
alias rg='rg -i'

# fd
alias fd='fd -H'

# fzf n stuff

# Last successful fzf selection, reusable later, e.g.:
#   cd "$(dirname "$FZF_LASTOUT")"
typeset -g FZF_LASTOUT=""

function catz() {
    local file
    file=$(fzf) || return 0
    typeset -g FZF_LASTOUT="$file"
    cat "$file"
}

function cdz() {
    local dir
    dir=$(fd --type d -H | fzf) || return 0
    typeset -g FZF_LASTOUT="$dir"
    cd "$dir"
}

function vimz() {
    # -h flag to search files in your current directory
    local file
    if [[ $# -gt 0 && $1 == '-h' ]]; then
        file=$(find . 2> /dev/null | fzf)
    else
        file=$(fzf)
    fi
    if [[ $? != 0 ]]; then
        return 0
    fi
    typeset -g FZF_LASTOUT="$file"
    vim "$file"
}

